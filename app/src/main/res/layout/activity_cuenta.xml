<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/home_background" android:fillViewport="true" android:padding="20dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:textColor="@color/ink_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mi cuenta" android:textSize="28sp" android:textStyle="bold" android:fontFamily="serif" android:layout_marginBottom="12dp" />
        <TextView android:textColor="@color/white" android:id="@+id/account" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="24dp" android:textIsSelectable="true" />
        <TextView android:textColor="@color/white" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tu colección se guarda primero en este móvil, incluso sin Internet. Los cambios pendientes se envían a Firebase al recuperar la conexión, desde cualquier pantalla. La primera entrada con Google, los préstamos y los amigos necesitan conexión. No borres los datos ni desinstales la app mientras queden cambios pendientes." />
        <Button android:textColor="@color/white" android:id="@+id/backup" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/ink_button" android:text="Crear copia adicional" android:layout_marginTop="@dimen/button_half_gap" android:layout_marginBottom="@dimen/button_half_gap" style="@style/InkShare.Button" android:backgroundTint="@null" app:backgroundTint="@null" />
        <Button android:textColor="@color/white" android:id="@+id/restore" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/ink_button" android:text="Importar copia anterior" android:layout_marginTop="@dimen/button_half_gap" android:layout_marginBottom="@dimen/button_half_gap" style="@style/InkShare.Button" android:backgroundTint="@null" app:backgroundTint="@null" />
        <Button android:textColor="@color/white" android:id="@+id/importLegacy" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/ink_button" android:text="Importar colección anterior" android:visibility="gone" android:layout_marginTop="@dimen/button_half_gap" android:layout_marginBottom="@dimen/button_half_gap" style="@style/InkShare.Button" android:backgroundTint="@null" app:backgroundTint="@null" />
        <Button android:textColor="@color/white" android:id="@+id/logout" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/ink_button" android:text="Cerrar sesión" android:layout_marginTop="@dimen/button_half_gap" android:layout_marginBottom="@dimen/button_half_gap" style="@style/InkShare.Button" android:backgroundTint="@null" app:backgroundTint="@null" />
        <Button android:textColor="@color/white" android:id="@+id/checkNotifications" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/ink_button" android:text="Comprobar notificaciones" android:layout_marginTop="@dimen/button_half_gap" android:layout_marginBottom="@dimen/button_half_gap" style="@style/InkShare.Button" android:backgroundTint="@null" app:backgroundTint="@null" />
        <TextView android:textColor="@color/white" android:id="@+id/collectionSyncStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityLiveRegion="polite" />
        <Button android:textColor="@color/white" android:id="@+id/retryCollectionSync" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/ink_button" android:text="Sincronizar colección" android:layout_marginTop="@dimen/button_half_gap" android:layout_marginBottom="@dimen/button_half_gap" style="@style/InkShare.Button" android:backgroundTint="@null" app:backgroundTint="@null" />
        <Button android:textColor="@color/white" android:id="@+id/resolveCollectionConflict" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/ink_button" android:text="Resolver cambio en conflicto" android:visibility="gone" android:layout_marginTop="@dimen/button_half_gap" android:layout_marginBottom="@dimen/button_half_gap" style="@style/InkShare.Button" android:backgroundTint="@null" app:backgroundTint="@null" />
        <ProgressBar android:id="@+id/cloudProgress" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />
        <TextView android:textColor="@color/white" android:id="@+id/cloudStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityLiveRegion="polite" />
    </LinearLayout>
</ScrollView>
