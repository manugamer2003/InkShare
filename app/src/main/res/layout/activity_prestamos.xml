<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/home_background" android:orientation="vertical" android:padding="16dp">
    <TextView android:textColor="@color/ink_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Préstamos" android:textSize="28sp" android:textStyle="bold" android:fontFamily="serif" android:layout_marginBottom="12dp" />
    <TextView android:textColor="@color/white" android:id="@+id/loanStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityLiveRegion="polite" />
    <Button android:id="@+id/newLoan" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:layout_marginBottom="12dp" android:background="@drawable/ink_button" android:text="Crear préstamo" android:textAllCaps="false" android:textColor="@color/white" style="@style/InkShare.Button" android:backgroundTint="@null" app:backgroundTint="@null" />
    <ScrollView android:id="@+id/loanDraft" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:textColor="@color/white" android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/loanDraftHelp" android:text="Elige hasta 10 cartas/acabados distintos. El préstamo registra la entrega; no cambia las cantidades de tu colección ni reserva copias." />
            <TextView android:textColor="@color/white" android:id="@+id/friendStatus" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <Button android:id="@+id/pickFriend" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="6dp" android:layout_marginBottom="6dp" android:background="@drawable/ink_button" android:text="Elegir amigo" android:textAllCaps="false" android:textColor="@color/white" style="@style/InkShare.Button" android:backgroundTint="@null" app:backgroundTint="@null" />
            <Button android:id="@+id/addLoanCard" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="6dp" android:layout_marginBottom="6dp" android:background="@drawable/ink_button" android:text="Añadir carta y cantidad" android:textAllCaps="false" android:textColor="@color/white" style="@style/InkShare.Button" android:backgroundTint="@null" app:backgroundTint="@null" />
            <LinearLayout android:id="@+id/draftItems" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            <Button android:id="@+id/saveLoan" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="6dp" android:layout_marginBottom="6dp" android:background="@drawable/ink_button" android:text="Revisar y crear préstamo" android:textAllCaps="false" android:textColor="@color/white" style="@style/InkShare.Button" android:backgroundTint="@null" app:backgroundTint="@null" />
            <Button android:id="@+id/cancelLoan" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="6dp" android:layout_marginBottom="6dp" android:background="@drawable/ink_button" android:text="Descartar borrador" android:textAllCaps="false" android:textColor="@color/white" style="@style/InkShare.Button" android:backgroundTint="@null" app:backgroundTint="@null" />
        </LinearLayout>
    </ScrollView>
    <com.google.android.material.tabs.TabLayout android:id="@+id/loanTabs" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/ink_panel" />
    <TextView android:textColor="@color/white" android:id="@+id/noLoans" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" />
    <ListView android:id="@+id/loanList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@android:color/transparent" android:dividerHeight="10dp" />
</LinearLayout>
