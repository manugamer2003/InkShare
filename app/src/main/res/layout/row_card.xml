<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/ink_panel" android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp">
    <ImageView android:id="@+id/cardImage" android:layout_width="76dp" android:layout_height="106dp" android:importantForAccessibility="no" android:scaleType="fitCenter" android:background="@drawable/ink_panel" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp">
        <TextView android:id="@+id/cardName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/ink_heading" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/cardIdentifier" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/white" />
        <TextView android:id="@+id/cardCounts" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/white" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/cardRowHint" android:text="Toca para editar cantidades" android:textColor="@color/ink_muted" android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
